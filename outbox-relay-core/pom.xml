<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.highkeen.opendcb</groupId>
        <artifactId>opendcb</artifactId>
        <version>1.3.1-SNAPSHOT</version>
    </parent>

    <artifactId>outbox-relay-core</artifactId>
    <!-- Framework-agnostic version line; see the root pom.xml's opendcb.version property comment. -->
    <version>${opendcb.version}</version>
    <packaging>jar</packaging>

    <name>OpenDCB :: Outbox Relay :: Core</name>
    <description>
        Framework-agnostic outbox relay: tails an EventStoreStorage log from a
        persisted "last relayed position" and hands events to a Publisher SPI.
        Depends only on eventstore-core.
    </description>
    <url>https://github.com/Highkeen-Technologies/opendcb</url>

    <scm>
        <connection>scm:git:https://github.com/Highkeen-Technologies/opendcb.git</connection>
        <developerConnection>scm:git:https://github.com/Highkeen-Technologies/opendcb.git</developerConnection>
        <url>https://github.com/Highkeen-Technologies/opendcb</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- Overrides the root pom.xml's maven.deploy.skip=true default: this is one of the 9
             publishable modules, so its deploy goal must actually run. -->
        <maven.deploy.skip>false</maven.deploy.skip>
        <h2.version>2.3.232</h2.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.highkeen.opendcb</groupId>
            <artifactId>eventstore-core</artifactId>
            <version>${opendcb.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Central publishing: version/config inherited from the root pom.xml's
                 pluginManagement; see the comment there for why examples/* don't declare these. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
