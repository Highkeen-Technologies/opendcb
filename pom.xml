<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.highkeen.opendcb</groupId>
    <artifactId>opendcb</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>OpenDCB</name>
    <description>
        Open-source Java toolkit providing DCB-capable event storage on any
        backing store, plus event routing, for event-sourcing frameworks.
    </description>
    <url>https://github.com/Highkeen-Technologies/opendcb</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Samik Roy</name>
            <organization>Highkeen Technologies</organization>
            <organizationUrl>https://highkeen.com</organizationUrl>
        </developer>
    </developers>

    <!--
      <url> and <scm> are deliberately NOT declared here for inheritance. Maven's default
      inheritance behavior for these elements appends the child module's artifactId to the
      parent's value (see maven.apache.org/pom.html#Inheritance and the Maven Model Builder's
      "Inheritance Assembly" docs), which would silently turn this mono-repo's single GitHub
      URL and git SCM URL into a broken per-module path (e.g. ".../opendcb/eventstore-core"
      instead of a valid GitHub URL, and a git clone URL with a bogus path segment appended).
      Maven 3.6.1+ offers child.*.inherit.append.path="false" attributes to suppress that, but
      relying on an obscure, easy-to-get-wrong attribute for metadata that becomes immutable
      once published to Maven Central is not worth the risk versus just repeating the identical,
      correct literal values in each of the 10 publishable modules below.
    -->

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <axon-framework-bom.version>5.1.2</axon-framework-bom.version>
        <jackson.version>2.22.1</jackson.version>
        <junit-bom.version>6.1.2</junit-bom.version>

        <!--
          Two independent version lines: see docs/ROADMAP.md's "Versioning" open question and
          docs/ARCHITECTURE.md's module dependency order. Framework-agnostic modules
          (eventstore-core/-postgres/-mysql/-mongo, outbox-relay-*, opendcb-scheduling-core) don't
          share Axon's release cadence, so they version independently as opendcb.version;
          Axon-coupled modules (integrations/eventstore-axon, bootstrap-axon-postgres,
          opendcb-axon-spring-boot-starter, opendcb-axon-spring-boot-routing,
          opendcb-conductor-bridge, opendcb-data-protection) are qualified with the Axon
          Framework version they're built against, as opendcb-axon.version.

          Every module in one of these two groups declares its own explicit <version> below,
          overriding this POM's inherited version (Maven only inherits <version> from the parent
          when the child does NOT declare its own; see the Maven POM reference's "Inheritance"
          section). Every inter-module <dependency> that crosses a version boundary must then
          reference ${opendcb.version} or ${opendcb-axon.version} explicitly, never
          ${project.version}: that property only ever resolves to the version of the POM being
          built, not of whatever it depends on, so once any module's version diverges from this
          aggregator's, ${project.version} silently becomes wrong for every other module's
          reference to it.

          This aggregator POM's own <version> (above) is not published or depended on by anything
          external; examples/* (not meant to be depended on externally either) are the only
          modules that inherit it unchanged, for simplicity.

          IMPORTANT — these two values below are LOCAL-DEV DEFAULTS ONLY, not "the current release
          version": a real release is always tag-driven (push a v X.Y.Z tag, or supply one via the
          workflow_dispatch "version" input) and .github/workflows/release.yml resolves/validates
          that tag/input, then overrides these properties on the command line via
          -Dopendcb.version=... -Dopendcb-axon.version=...-<axon-qualifier>, which
          flatten-maven-plugin (below) bakes into the POM actually published to Maven Central. A
          plain local `mvn install` with no -D override just uses whatever's committed here, which
          is fine since nothing gets published that way. Consequently, NO commit or PR should ever
          exist whose sole purpose is bumping these two numbers going forward — see
          docs/ROADMAP.md's "Versioning" section for the full scheme.
        -->
        <opendcb.version>1.0.0</opendcb.version>
        <opendcb-axon.version>1.0.0-axon5.1</opendcb-axon.version>

        <!--
          gpg:sign is bound to the verify phase (below), which plain `mvn clean install` also
          runs through, so signing must not be a default part of every local/CI build, since it
          requires a GPG key most machines running `install` don't have. Default to skipping it;
          the "release" profile below flips this to false for the real publish flow
          (`mvn clean deploy -P release`).
        -->
        <gpg.skip>true</gpg.skip>

        <!--
          maven-deploy-plugin's own `deploy` goal binds to every module in the reactor by default
          (this aggregator POM itself included, since packaging=pom projects go through the deploy
          phase too), regardless of whether central-publishing-maven-plugin is configured anywhere
          else. This aggregator is never meant to be published itself — it exists purely to define
          the reactor and shared config — and neither is anything under examples/*. Both rely on
          this same maven.deploy.skip=true default (maven-deploy-plugin's `skip` parameter's own
          built-in user property, confirmed via `mvn maven-deploy-plugin:3.1.4:help -Dgoal=deploy
          -Ddetail=true` rather than assumed) so `mvn deploy`/`mvn clean deploy` never attempts to
          upload them; examples/* additionally still declare an explicit, redundant-but-harmless
          <skip>true</skip> plugin stub of their own from before this property existed. Each of the
          10 publishable modules overrides this back to false in its own <properties>, the same
          override-in-the-child pattern as opendcb.version/opendcb-axon.version above.
        -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <modules>
        <module>eventstore-core</module>
        <module>eventstore-postgres</module>
        <module>integrations/eventstore-axon</module>
        <module>bootstrap-axon-postgres</module>
        <module>opendcb-axon-spring-boot-starter</module>
        <module>opendcb-axon-spring-boot-routing</module>
        <module>outbox-relay-core</module>
        <module>outbox-relay-rabbitmq</module>
        <module>opendcb-scheduling-core</module>
        <module>opendcb-conductor-bridge</module>
        <module>opendcb-data-protection</module>
        <module>opendcb-data-protection-vault</module>
        <module>opendcb-data-protection-aws-kms</module>
        <module>examples/plain-java-sample</module>
        <module>examples/microservices-sample/orders-service</module>
        <module>examples/microservices-sample/shipping-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.axonframework</groupId>
                <artifactId>axon-framework-bom</artifactId>
                <version>${axon-framework-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>

                <!--
                  Maven Central publishing prerequisites (see docs/ROADMAP.md's "Publishing
                  target" open question). Declared here in pluginManagement so version and
                  execution config live in one place, but NOT bound to <build><plugins> in this
                  parent POM: that would apply to every child, including examples/*, which are
                  deliberately never published. Each of the 10 publishable modules opts in with its
                  own minimal <build><plugins> stub referencing these by groupId/artifactId only;
                  examples/* modules declare nothing extra, so these plugins are configured but
                  never actually invoked for them. Verified against Maven's documented
                  pluginManagement merge behavior: version and <configuration>/<executions> DO
                  merge down from pluginManagement into a plugin a child module declares, so the
                  per-module stubs below don't need to repeat any of that.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <!-- 3.4.0 is the latest STABLE release; maven-metadata.xml's <release> tag
                         currently points at 4.0.0-beta-1, a beta not used here. -->
                    <version>3.4.0</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <!--
                      Signs every attached artifact (jar, sources jar, javadoc jar) at deploy
                      time, required by Maven Central. No passphrase is configured here, and
                      none may ever be committed to this repo: gpg:sign's useAgent parameter
                      (gpg.useagent, default true) delegates passphrase supply to a locally primed
                      gpg-agent with zero Maven config, and for CI/batch use its
                      passphraseEnvName parameter (gpg.passphraseEnvName, default
                      MAVEN_GPG_PASSPHRASE, since plugin 3.2.0) reads the passphrase from an
                      environment variable instead; both are the plugin's own current,
                      non-deprecated recommendation (its older passphrase/passphraseServerId
                      parameters are deprecated specifically because they risk leaking the
                      secret). Whoever runs the real `mvn deploy` sets MAVEN_GPG_PASSPHRASE (or
                      primes gpg-agent) in their own environment; this POM stays credential-free.
                    -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                    <configuration>
                        <skip>${gpg.skip}</skip>
                    </configuration>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <!--
                      Uploads to Maven Central via the current (2025+) Central Publisher Portal
                      API, replacing the old OSSRH/Nexus staging workflow that was shut down
                      2025-06-30. autoPublish is deliberately NOT set (defaults to false): the
                      first release should land as a manual-publish deployment, reviewed at
                      central.sonatype.com before it goes live, since Central is immutable: a
                      published version can never be removed or modified afterward. Credentials
                      (a Central Portal user token, generated from a Sonatype account) belong in
                      settings.xml's <server id="central"> block matching publishingServerId
                      below, never in this POM.
                    -->
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.11.0</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                    </configuration>
                </plugin>
                <plugin>
                    <!--
                      examples/* modules build with this same parent, so maven-deploy-plugin's
                      default deploy goal (bound to the deploy phase for every module regardless
                      of central-publishing-maven-plugin's presence elsewhere) would otherwise
                      still attempt to deploy them. They aren't publishable library artifacts (see
                      docs/ARCHITECTURE.md's module list), so each examples/* module declares this
                      plugin in its own build/plugins with skip=true. Declared here only for a
                      pinned, grounded version, not bound to build/plugins in this parent, same
                      pattern as the Central-publishing plugins above.
                    -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <!-- 3.1.4 is the latest STABLE release; maven-metadata.xml's release/latest
                         tags currently point at 4.0.0-beta-2, a beta not used here. -->
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <!--
                      Resolves ${opendcb.version} / ${opendcb-axon.version} (and the parent
                      reference) down to real, literal values in a generated flattened POM, which
                      transparently replaces the original pom.xml for install/deploy purposes.
                      Without this, the POM actually published to Maven Central would contain the
                      literal, unresolved text "${opendcb.version}" as its <version>, since Central
                      serves POMs to consumers as-is with no property substitution.

                      flattenMode=ossrh (not the default "defaults" mode, and deliberately not
                      "resolveCiFriendliesOnly") — verified against the plugin's own
                      flatten-mojo.html/usage.html docs rather than assumed:
                        - "resolveCiFriendliesOnly" only resolves the three specific,
                          plugin-reserved property names revision/sha1/changelist (Maven's own "CI
                          Friendly Versions" convention; revision's name is the only one
                          reconfigurable, via revisionVariableName, added in 1.8.0). This project
                          uses its own two custom property names instead
                          (opendcb.version/opendcb-axon.version), which that mode would NOT
                          resolve — it would leave them as literal unresolved property references
                          in the flattened POM, silently defeating the whole point.
                        - The other, non-CI-friendly modes (oss/ossrh/defaults/clean/bom) instead
                          compute the full effective POM and resolve EVERY property placeholder,
                          including custom-named ones, into literal values — this is what a normal
                          <version>${opendcb.version}</version> needs.
                        - "ossrh" specifically is the preset purpose-built to keep exactly the
                          optional POM elements Sonatype's OSS Repository-Hosting requirements
                          need (name, description, url, licenses, developers, scm — already
                          verified inherited correctly per-module) while stripping everything else
                          (the now-redundant, already-resolved <properties>, build config, etc.) —
                          matching this project's Central-publishing use case precisely.

                      Execution bindings match the plugin's own documented usage example: the
                      `flatten` goal runs in `process-resources` (early enough that every later
                      phase — compile, test, package, install, deploy — sees the flattened POM),
                      and the `clean` goal (no explicit phase — it declares its own default binding
                      to the `clean` lifecycle) deletes the generated .flattened-pom.xml so it never
                      lingers as an untracked file between builds.
                    -->
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.8.0</version>
                    <configuration>
                        <flattenMode>ossrh</flattenMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
      Activate with `mvn clean deploy -P release` for the real Maven Central publish flow.
      Everything else (source/javadoc attachment, the central-publishing-maven-plugin upload
      binding to the deploy phase) is already wired unconditionally in each of the 10 publishable
      modules; the only thing gated behind this profile is turning GPG signing back on, since
      that's the one step plain `mvn clean install` must not attempt without a configured key.
    -->
    <profiles>
        <profile>
            <id>release</id>
            <properties>
                <gpg.skip>false</gpg.skip>
            </properties>
        </profile>
    </profiles>
</project>
