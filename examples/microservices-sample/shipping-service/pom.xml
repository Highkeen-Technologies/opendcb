<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.highkeen.opendcb</groupId>
        <artifactId>opendcb</artifactId>
        <version>1.2.1-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>shipping-service</artifactId>
    <!-- No own <version>: examples/* aren't published or meant to be depended on externally,
         so they simply inherit the aggregator's version unchanged (see root pom.xml's
         opendcb.version property comment). -->
    <packaging>jar</packaging>
    <name>OpenDCB :: Examples :: Microservices Sample :: Shipping Service</name>
    <description>
        Bounded-context example: a real RabbitMQ consumer plus an
        anti-corruption-layer translator that converts an incoming
        OrderPlacedIntegrationEvent into a local CreateShipmentCommand against
        this service's own, entirely separate PostgreSQL event store —
        deduping by the integration event's eventId so at-least-once delivery
        never creates more than one shipment for the same order.
    </description>

    <properties>
        <postgresql.version>42.7.4</postgresql.version>
        <amqp-client.version>5.30.0</amqp-client.version>
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.highkeen.opendcb</groupId>
            <artifactId>bootstrap-axon-postgres</artifactId>
            <version>${opendcb-axon.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>amqp-client</artifactId>
            <version>${amqp-client.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- End-to-end test dispatches through orders-service's own OrdersService/PlaceOrder/
             OrderPlacedIntegrationEvent to prove the whole cross-bounded-context flow, not just
             shipping-service in isolation. orders-service is an unversioned examples/* module
             like this one (both inherit the aggregator's version unchanged), so ${project.version}
             correctly targets it here; it is NOT safe to assume this equivalence for any
             non-examples/* dependency, which is why every other reference in this file uses an
             explicit opendcb.version/opendcb-axon.version property instead. -->
        <dependency>
            <groupId>com.highkeen.opendcb</groupId>
            <artifactId>orders-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.highkeen.opendcb</groupId>
            <artifactId>outbox-relay-rabbitmq</artifactId>
            <version>${opendcb.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.highkeen.opendcb</groupId>
            <artifactId>eventstore-postgres</artifactId>
            <version>${opendcb.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- examples/* are not publishable library artifacts; skip deploy entirely. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
