<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.highkeen.opendcb</groupId>
        <artifactId>opendcb</artifactId>
        <version>1.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>bootstrap-axon-postgres</artifactId>
    <!-- Axon-tied version line, qualified with the Axon Framework version this module is built
         against; see the root pom.xml's opendcb-axon.version property comment. -->
    <version>${opendcb-axon.version}</version>
    <packaging>jar</packaging>

    <name>OpenDCB :: Bootstrap :: Axon + PostgreSQL</name>
    <description>
        Zero-boilerplate wiring of integrations/eventstore-axon and
        eventstore-postgres into a working EventStorageEngine, for non-Spring
        consumers. The one module in this toolkit allowed to depend on both
        an integrations/eventstore-&lt;framework&gt; module and a specific
        eventstore-&lt;provider&gt; module.
    </description>
    <url>https://github.com/Highkeen-Technologies/opendcb</url>

    <scm>
        <connection>scm:git:https://github.com/Highkeen-Technologies/opendcb.git</connection>
        <developerConnection>scm:git:https://github.com/Highkeen-Technologies/opendcb.git</developerConnection>
        <url>https://github.com/Highkeen-Technologies/opendcb</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- Overrides the root pom.xml's maven.deploy.skip=true default: this is one of the 9
             publishable modules, so its deploy goal must actually run. -->
        <maven.deploy.skip>false</maven.deploy.skip>
        <postgresql.version>42.7.4</postgresql.version>
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.highkeen.opendcb</groupId>
            <artifactId>eventstore-axon</artifactId>
            <version>${opendcb-axon.version}</version>
        </dependency>
        <dependency>
            <groupId>com.highkeen.opendcb</groupId>
            <artifactId>eventstore-postgres</artifactId>
            <version>${opendcb.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Central publishing: version/config inherited from the root pom.xml's
                 pluginManagement; see the comment there for why examples/* don't declare these. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
