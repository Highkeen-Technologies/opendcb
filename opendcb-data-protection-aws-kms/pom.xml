<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.highkeen.opendcb</groupId>
        <artifactId>opendcb</artifactId>
        <version>1.3.1-SNAPSHOT</version>
    </parent>

    <artifactId>opendcb-data-protection-aws-kms</artifactId>
    <!-- Framework-agnostic version line, same reasoning as opendcb-data-protection-vault's own
         version comment: AwsKmsMasterKeyProvider implements only
         com.highkeen.opendcb.dataprotection.MasterKeyProvider plus the AWS SDK for KMS — zero
         org.axonframework import anywhere in this module. Its dependency on opendcb-data-protection
         is an explicit, version-boundary-crossing reference to ${opendcb-axon.version} below. -->
    <version>${opendcb.version}</version>
    <packaging>jar</packaging>

    <name>OpenDCB :: Data Protection :: AWS KMS</name>
    <description>
        MasterKeyProvider implementation for opendcb-data-protection backed by AWS KMS (Encrypt/
        Decrypt operations against a configured CMK). Managed, lower operational burden than
        self-hosting Vault; has a Mumbai (ap-south-1) region for RBI-style data-localization
        requirements without cross-border key material transfer. Depends only on
        opendcb-data-protection's MasterKeyProvider interface and the AWS SDK for KMS; changes
        nothing in opendcb-data-protection itself.
    </description>
    <url>https://github.com/Highkeen-Technologies/opendcb</url>

    <scm>
        <connection>scm:git:https://github.com/Highkeen-Technologies/opendcb.git</connection>
        <developerConnection>scm:git:https://github.com/Highkeen-Technologies/opendcb.git</developerConnection>
        <url>https://github.com/Highkeen-Technologies/opendcb</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- Overrides the root pom.xml's maven.deploy.skip=true default: this is one of the
             publishable modules, so its deploy goal must actually run. -->
        <maven.deploy.skip>false</maven.deploy.skip>
        <!-- AWS SDK v2, not v1 — v2 is AWS's current, actively developed major line (v1 is in
             maintenance-only mode). Version confirmed against repo1.maven.org's own
             maven-metadata.xml (<release>/<latest> both 2.53.1 at the time this was verified),
             not assumed. -->
        <aws-sdk-kms.version>2.53.1</aws-sdk-kms.version>
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.highkeen.opendcb</groupId>
            <artifactId>opendcb-data-protection</artifactId>
            <!-- Explicit version-boundary-crossing reference, per the root pom.xml's Versioning
                 comment — see opendcb-data-protection-vault's identical pattern/comment. -->
            <version>${opendcb-axon.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>kms</artifactId>
            <version>${aws-sdk-kms.version}</version>
        </dependency>

        <!--
          Explicit direct dependencies needed to win Maven's depth-based mediation, same bug shape
          documented in docs/CONVENTIONS.md's "Dependency mediation" section and already fixed once
          in opendcb-data-protection's own pom.xml: testcontainers pulls in
          com.github.docker-java:docker-java-api (test scope), which declares jackson-annotations
          2.10.3 directly at depth 3 (this module -> testcontainers -> docker-java-api ->
          jackson-annotations), beating axon-common's jackson-databind requirement at depth 4 (this
          module -> opendcb-data-protection -> axon-messaging -> axon-common -> jackson-databind ->
          jackson-annotations) under Maven's nearest-wins rule. opendcb-data-protection's own
          test-scoped pin does NOT propagate here — Maven never inherits a dependency's test-scope
          dependencies transitively — so this module needs its own pin, confirmed via
          `mvn dependency:tree -Dverbose` showing jackson-annotations:2.10.3 winning and
          jackson-core:2.21.2 (mismatched with jackson-databind:2.22.1) also winning over the
          axon-conversion path's own jackson-core:2.22.1.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <!-- jackson-annotations does not follow jackson-databind's patch-level versioning; 2.22
                 (no patch suffix) is what jackson-databind 2.22.1 itself actually resolves to. -->
            <version>2.22</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Central publishing: version/config inherited from the root pom.xml's
                 pluginManagement; see the comment there for why examples/* don't declare these. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
